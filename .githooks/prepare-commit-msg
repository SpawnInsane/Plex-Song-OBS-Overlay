#!/bin/sh
set -eu

message_file=$1
message_source=${2:-}

# Never replace an explicit message or Git-generated merge/squash/amend message.
if [ -n "$message_source" ]; then
  exit 0
fi

# Ignore Git's comment lines when deciding whether the editor supplied a message.
if sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$message_file" | grep -q .; then
  exit 0
fi

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged_files" ]; then
  printf '%s\n' 'chore: record repository state' > "$message_file"
  exit 0
fi

if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  if printf '%s\n' "$staged_files" | grep -Eq '^(main\.go|web/)'; then
    printf '%s\n' 'feat: add Plex song OBS overlay' > "$message_file"
  else
    printf '%s\n' 'chore: initialize repository' > "$message_file"
  fi
  exit 0
fi

has_runtime=false
has_new_runtime=false
has_tests=false
has_docs=false
has_workflows=false
has_dependencies=false

if printf '%s\n' "$staged_files" | grep -Eq '^(main\.go|web/)'; then has_runtime=true; fi
if git diff --cached --name-only --diff-filter=A | grep -Eq '^(main\.go|web/)'; then has_new_runtime=true; fi
if printf '%s\n' "$staged_files" | grep -Eq '(_test\.go$|^\.github/scripts/)'; then has_tests=true; fi
if printf '%s\n' "$staged_files" | grep -Eq '^(README\.md|SECURITY\.md|body\.md|AGENTS\.md|\.github/RELEASES\.md)$'; then has_docs=true; fi
if printf '%s\n' "$staged_files" | grep -Eq '^\.github/workflows/'; then has_workflows=true; fi
if printf '%s\n' "$staged_files" | grep -Eq '^(go\.(mod|sum)|renovate\.json)$'; then has_dependencies=true; fi

if $has_runtime && $has_new_runtime; then
  message='feat: extend Plex song grabber'
elif $has_runtime; then
  message='fix: update Plex song grabber'
elif $has_workflows; then
  message='chore(ci): update GitHub automation'
elif $has_dependencies; then
  message='chore(deps): update dependencies'
elif $has_tests; then
  message='test: update automated tests'
elif $has_docs; then
  message='docs: update documentation'
else
  message='chore: update repository files'
fi

printf '%s\n' "$message" > "$message_file"
